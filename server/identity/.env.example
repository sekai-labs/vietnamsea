# Identity service environment template
# Copy this file to .env and adjust values for your local/staging environment.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity
DB_USERNAME=postgres
DB_PASSWORD=12345

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Legacy JWT keys currently referenced in application.yaml
ACCESS_TOKEN_KEY=replace_with_access_token_key
ACCESS_TOKEN_MAX_AGE=3600
REFRESH_TOKEN_KEY=replace_with_refresh_token_key
REFRESH_TOKEN_MAX_AGE=604800

# OAuth2 encryption master key
OAUTH_MASTER_KEY=replace_with_oauth_master_key

# JWT settings used by JwtConfig/JwtKeyProvider (recommended)
SECURITY_JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
SECURITY_JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
SECURITY_JWT_KEY_ID=identity-key-1
SECURITY_JWT_ISSUER=vietnamsea-identity
SECURITY_JWT_MAX_AGE=3600
